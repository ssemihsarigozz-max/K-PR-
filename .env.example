# Gerçek değerleri .env.local içinde saklayın; tarayıcıya veya Git'e koymayın.
PORT=4173
OKX_CLI_PATH=node_modules/@okx_ai/okx-trade-cli/dist/index.js
OKX_PROFILE=demo
ENABLE_OKX_ORDERS=false
MAX_ORDER_TRY=1000
APPROVAL_TTL_MS=120000

AVALANCHE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_FUJI_PRIVATE_KEY=
DECISION_LEDGER_ADDRESS=
AUTO_RECORD_FUJI=false

# Yerel agent yalnızca paper trading yapar; gerçek emir sisteminden ayrıdır.
AGENT_AUTO_START=true
AGENT_INTERVAL_MS=60000
AGENT_BUDGET_TRY=1000
AGENT_MAX_PREMIUM_PCT=0.8
PAPER_INITIAL_TRY=10000
PAPER_FEE_PCT=0.1
PAPER_MAX_TRADES_PER_DAY=3
PAPER_COOLDOWN_MS=1800000
PAPER_MAX_EXPOSURE_TRY=5000
AGENT_STATE_PATH=.local-data/agent-state.json
